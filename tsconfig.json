{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // "node" is only needed by the tests, which read the reference BMP off disk.
    "types": ["vite/client", "node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // Deliberately NOT enabling noUncheckedIndexedAccess: every typed-array read in
    // the pixel loops would widen to `number | undefined` and need a non-null
    // assertion, which buries the actual arithmetic.

    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src", "test", "vite.config.ts"]
}
